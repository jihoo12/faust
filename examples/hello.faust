extern printf(fmt: *i8, ...) -> i32 !{extern, asm, syscalls 1};

fn add(a: i32, b: i32) -> i32 {
  return a + b;
}

fn print(x: i32) -> i32 !{extern, asm, syscalls 1} {
  return printf("%d\n", x);
}

fn main() -> i32 !{extern, asm, syscalls 1} {
  let answer = add(20, 22);
  print(answer);
  return 0;
}
